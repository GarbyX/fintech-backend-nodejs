// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Configure PostgreSQL Schema with Prisma
// In financial systems, floating-point numbers (FLOAT/DOUBLE) cause rounding errors. Use Decimal for balance amounts and PostgreSQL ACID transactions for money transfers.

enum TransactionType {
  DEPOSIT
  TRANSFER
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  accounts  Account[]
}

model Account {
  id           String        @id @default(uuid())
  accountNum   String        @unique
  balance      Decimal       @default(0.00) @db.Decimal(18, 4)
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  sentTx       Transaction[] @relation("Sender")
  receivedTx   Transaction[] @relation("Receiver")
  createdAt    DateTime      @default(now())
}

model Transaction {
  id          String          @id @default(uuid())
  amount      Decimal         @db.Decimal(18, 4)
  type        TransactionType
  senderId    String?
  sender      Account?        @relation("Sender", fields: [senderId], references: [id])
  receiverId  String
  receiver    Account         @relation("Receiver", fields: [receiverId], references: [id])
  createdAt   DateTime        @default(now())
}